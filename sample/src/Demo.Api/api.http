@hostname=localhost
@port=45612
@host={{hostname}}:{{port}}
@api-version=1.0
@user-id=00000000-0000-0000-0000-000000000007
@user-email=james@bond.com

// GET All Users
GET https://{{host}}/api/users?api-version={{api-version}}
Accept: application/json

###

// Get Single User By Id
GET https://{{host}}/api/users/{{user-id}}?api-version={{api-version}}
Accept: application/json

###

// Get Single User By Email
GET https://{{host}}/api/users/email?api-version={{api-version}}&email={{user-email}}
Accept: application/json

###

// Create Single User
POST https://{{host}}/api/users?api-version={{api-version}}
Content-Type: application/json

{
  "gender": "Male",
  "firstName": "John",
  "lastName": "Doe",
  "email": "john@doe.com",
  "telephone": "762.703.8288",
  "homePage": "http://jazmyn.name/",
  "homeAddress": {
    "streetName": "Nels Way",
    "streetNumber": "0146",
    "postalCode": "26692-6959",
    "cityName": "Marcelinoview",
    "country": {
  	"name": "Ecuador",
  	"alpha2Code": "DK",
  	"alpha3Code": "DNK"
    }
  },
  "workAddress": {
    "streetName": "Johnathan Estate",
    "streetNumber": "01908",
    "postalCode": "23166-5252",
    "cityName": "West Hermanfort",
    "country": {
  	"name": "Kyrgyz Republic",
  	"alpha2Code": "DK",
  	"alpha3Code": "DNK"
    }
  }
}

###

// Import Users - each user is validated as on create; an error names the user by its index ([1].firstName)
POST https://{{host}}/api/users/import?api-version={{api-version}}
Content-Type: application/json

[
  { "gender": "Female", "firstName": "Ada", "lastName": "Lovelace", "email": "ada@example.com" },
  { "gender": "Female", "firstName": "grace", "lastName": "Hopper", "email": "grace@example.com" }
]

###

// Update Single User
PUT https://{{host}}/api/users/{{user-id}}?api-version={{api-version}}
Content-Type: application/json

{
  "gender": "Female",
  "firstName": "j",
  "lastName": "Doe",
  "email": "jane@doe.com",
  "address": {
    "streetName": "Johnathan Estate",
    "streetNumber": "01908",
    "postalCode": "23166-5252",
    "cityName": "W",
    "country": {
  	"name": "Kyrgyz Republic",
  	"alpha2Code": "DK",
  	"alpha3Code": "DNK"
    }
  }
}

###

// Delete Single User By Id
Delete https://{{host}}/api/users/{{user-id}}?api-version={{api-version}}
Accept: application/json

###

// ---------- Error-handling simulations (watch logs/traces/metrics in the Aspire dashboard) ----------

// Server error: 500, one Error log (event 10000) with the exception
GET https://{{host}}/api/test/errors/server?api-version={{api-version}}
x-correlation-id: sim-corr-server
x-request-id: sim-req-server

###

// Client error: 400, one Debug log (event 10001) without the exception
GET https://{{host}}/api/test/errors/client?api-version={{api-version}}&value=bad-value
x-correlation-id: sim-corr-client
x-request-id: sim-req-client

###

// Exception after the response has started: response aborted, one Warning (event 10003) + exactly one Error (from Kestrel)
GET https://{{host}}/api/test/errors/stream-then-throw?api-version={{api-version}}
x-correlation-id: sim-corr-stream
x-request-id: sim-req-stream

###

// Client disconnect: cancel this request after a few seconds -> one Debug log (event 10002), no Error
GET https://{{host}}/api/test/errors/slow-stream?api-version={{api-version}}
x-correlation-id: sim-corr-slow
x-request-id: sim-req-slow

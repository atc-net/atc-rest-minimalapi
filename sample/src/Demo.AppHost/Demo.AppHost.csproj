<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <IsPackable>false</IsPackable>
    <UserSecretsId>demo-apphost-secrets</UserSecretsId>
    <!-- C# AppHosts get the orchestrator and dashboard from the Aspire CLI bundle -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
  </ItemGroup>

</Project>

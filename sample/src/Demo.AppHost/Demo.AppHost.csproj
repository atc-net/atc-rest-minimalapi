<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <IsPackable>false</IsPackable>
    <UserSecretsId>demo-apphost-secrets</UserSecretsId>
    <!-- Use the Aspire CLI bundle (orchestrator + dashboard), as new Aspire 13.5 templates do (ASPIRE010) -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Demo.Api\Demo.Api.csproj" />
    <ProjectReference Include="..\Demo.Web\Demo.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
  </ItemGroup>

  <ItemGroup Label="Temporary">
    <!--
      MessagePack v2.5.302 is pulled in by Aspire.Hosting.JavaScript v13.6.1 and has a known vulnerability:
      https://github.com/advisories/GHSA-qhrr-8q5h-9q3h. Pin the patched version with a direct reference until Aspire
      releases a package that brings it.
    -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

</Project>